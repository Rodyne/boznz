		<title>Please don&#8217;t read this if you are in the EU.</title>
		<link>https://rodyne.com/?p=2368</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Thu, 10 Apr 2025 21:13:04 +0000</pubDate>
