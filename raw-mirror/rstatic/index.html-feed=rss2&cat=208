	<item>
		<title>Random Emails from Strangers are Still Nice to Get.</title>
		<link>https://rodyne.com/?p=3848</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Fri, 06 Mar 2026 01:08:42 +0000</pubDate>
				<category><![CDATA[AI]]></category>
		<category><![CDATA[boz]]></category>
		<category><![CDATA[Boz NZ]]></category>
		<category><![CDATA[The Ramblings of an Old Man]]></category>
