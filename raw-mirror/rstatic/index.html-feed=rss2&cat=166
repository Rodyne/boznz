		<title>Technology for Everyone.. Are You Sure?</title>
		<link>https://rodyne.com/?p=2290</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Tue, 08 Apr 2025 02:28:43 +0000</pubDate>
				<category><![CDATA[Bad Management]]></category>
