		<title>Some of the Lessons Learnt from Writing my First Book</title>
		<link>https://rodyne.com/?p=2589</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Mon, 23 Oct 2023 19:25:15 +0000</pubDate>
				<category><![CDATA[Bad Management]]></category>
		<category><![CDATA[Books]]></category>
