		<title>Small Blinkenlight Update</title>
		<link>https://rodyne.com/?p=3533</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Mon, 19 Jan 2026 22:05:55 +0000</pubDate>
				<category><![CDATA[blinkenlights]]></category>
		<category><![CDATA[Other Programming]]></category>
		<category><![CDATA[PicoMite]]></category>
		<category><![CDATA[Programming]]></category>
		<category><![CDATA[Retro]]></category>
