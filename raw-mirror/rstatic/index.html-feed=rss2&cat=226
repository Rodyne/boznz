		<title>Dungeon Newbie</title>
		<link>https://rodyne.com/?p=2855</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Fri, 30 May 2025 02:29:38 +0000</pubDate>
				<category><![CDATA[boz]]></category>
