		<item>
		<title>I&#8217;m an ASI. Ask Me Anything.</title>
		<link>https://rodyne.com/?p=2596</link>
					<comments>https://rodyne.com/?p=2596#comments</comments>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Fri, 25 Apr 2025 00:49:39 +0000</pubDate>
				<category><![CDATA[AI]]></category>
		<category><![CDATA[AI Alignment]]></category>
