	<item>
		<title>Can I Now Please Go Back to a Dumb-Phone?</title>
		<link>https://rodyne.com/?p=4105</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Fri, 18 Sep 2026 21:05:32 +0000</pubDate>
