	<item>
		<title>NOW is the Time to Eat Their Lunch</title>
		<link>https://rodyne.com/?p=3875</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Thu, 12 Mar 2026 21:10:43 +0000</pubDate>
