		<title>Humanity Needs Aliens to Survive</title>
		<link>https://rodyne.com/?p=3051</link>
					<comments>https://rodyne.com/?p=3051#comments</comments>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
