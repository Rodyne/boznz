		<title>The Timeline for my First Book is Now Playing Out!</title>
		<link>https://rodyne.com/?p=1997</link>
		
		<dc:creator><![CDATA[admin]]></dc:creator>
		<pubDate>Sat, 19 Apr 2025 06:33:00 +0000</pubDate>
				<category><![CDATA[AI]]></category>
		<category><![CDATA[AI Alignment]]></category>
